NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Serveur uniquement (jamais NEXT_PUBLIC_) : création des comptes chauffeurs par téléphone
# et génération de leurs codes d'accès.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optionnel — fuseau de la flotte : Africa/Kinshasa (défaut, UTC+1) ou Africa/Lubumbashi (UTC+2)
NEXT_PUBLIC_APP_TIMEZONE=Africa/Kinshasa

# Optionnel — taux USD→CDF utilisé si l'API de change ne répond pas (défaut 2800)
USD_CDF_FALLBACK_RATE=2800

# Optionnel — domaine des identifiants techniques des chauffeurs (jamais utilisé pour envoyer d'email)
DRIVER_LOGIN_EMAIL_DOMAIN=chauffeurs.taxiflow.invalid

# Optionnel — URL publique du site (liens dans les messages WhatsApp ; sur Vercel elle est détectée)
NEXT_PUBLIC_SITE_URL=https://taxi-flow-rdc.vercel.app

# Mobile Money via pawaPay (M-Pesa, Airtel Money, Orange Money) — https://dashboard.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=sandbox

# Connexion chauffeur par SMS / WhatsApp (après configuration du fournisseur SMS dans Supabase)
NEXT_PUBLIC_SMS_LOGIN_ENABLED=false

# Alertes WhatsApp quotidiennes (API Cloud de Meta) + secret de la tâche planifiée Vercel
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=taxiflow_alerte
WHATSAPP_TEMPLATE_LANG=fr
CRON_SECRET=
